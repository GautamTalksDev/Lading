# Reproducible inventory fixtures. Run from repo root:
#   make -C testdata/inventory
#
# Binaries are committed under bin/ so CI on macOS/Windows can exercise
# ELF fixtures without a Linux cross-compiler. Rebuild on Linux when
# sources change.
#
# Guard: `make -C testdata/inventory verify-fixtures` (also CI) asserts every
# entry in FIXTURES is git-tracked and matches FIXTURES.sha.

ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
REPO := $(abspath $(ROOT)/../..)
SRC  := $(ROOT)/src
BIN  := $(ROOT)/bin
CC   ?= gcc
CXX  ?= g++

# Single source of truth for committed binaries. list-fixtures / verify-fixtures /
# CI check-fixtures.sh all derive from this list — do not hardcode elsewhere.
FIXTURES := \
	$(BIN)/dyn_unstripped_elf \
	$(BIN)/dyn_stripped_elf \
	$(BIN)/static_stripped_elf \
	$(BIN)/cxx_mangled_elf \
	$(BIN)/symver_ssl_elf \
	$(BIN)/symver_def.so \
	$(BIN)/weak_ifunc_elf \
	$(BIN)/sample_pe.exe \
	$(BIN)/sample_macho \
	$(BIN)/sample_macho_fat \
	$(BIN)/truncated_elf

.PHONY: all clean verify list-fixtures verify-fixtures fixtures.sha

all: $(FIXTURES) $(BIN)/README.md

# Print one repo-relative path per line (for CI / scripts).
list-fixtures:
	@for f in $(FIXTURES); do echo "$${f#$(REPO)/}"; done

$(BIN):
	mkdir -p $(BIN)

$(BIN)/dyn_unstripped_elf: $(SRC)/dyn.c | $(BIN)
	$(CC) -O0 -g -o $@ $<

$(BIN)/dyn_stripped_elf: $(SRC)/dyn.c | $(BIN)
	$(CC) -O0 -s -o $@ $<

$(BIN)/static_stripped_elf: $(SRC)/dyn.c | $(BIN)
	$(CC) -O0 -static -s -o $@ $<

$(BIN)/cxx_mangled_elf: $(SRC)/cxx.cpp | $(BIN)
	$(CXX) -O0 -g -o $@ $<

$(BIN)/symver_ssl_elf: $(SRC)/sslver.c | $(BIN)
	$(CC) -O0 -g -o $@ $< $(shell pkg-config --libs libssl libcrypto 2>/dev/null || echo -lssl -lcrypto)

$(BIN)/symver_def.so: $(SRC)/vers.c $(SRC)/vers.map | $(BIN)
	$(CC) -shared -fPIC -Wl,--version-script=$(SRC)/vers.map -o $@ $(SRC)/vers.c

$(BIN)/weak_ifunc_elf: $(SRC)/weak_ifunc.c | $(BIN)
	$(CC) -O0 -g -o $@ $<

$(BIN)/sample_pe.exe: $(SRC)/gocross/main.go | $(BIN)
	cd $(SRC)/gocross && GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build -ldflags="-s -w" -o $(BIN)/sample_pe.exe .

$(BIN)/sample_macho: $(SRC)/gocross/main.go | $(BIN)
	cd $(SRC)/gocross && GOOS=darwin GOARCH=amd64 CGO_ENABLED=0 go build -ldflags="-s -w" -o $(BIN)/sample_macho .

# Universal (fat) Mach-O with a single x86_64 slice — thin binary wrapped in a
# big-endian fat header. Deterministic; no lipo required. See bin/README.md.
$(BIN)/sample_macho_fat: $(BIN)/sample_macho $(ROOT)/scripts/wrap-macho-fat.py
	python3 $(ROOT)/scripts/wrap-macho-fat.py $< $@

$(BIN)/truncated_elf: | $(BIN)
	# Valid ELF magic then truncated — must Warning, not panic.
	printf '\177ELF\x02\x01\x01\x00' > $@
	dd if=/dev/zero bs=1 count=24 >> $@ 2>/dev/null

$(BIN)/README.md: | $(BIN)
	@printf '%s\n' \
		'# Inventory fixtures' \
		'' \
		'Built by `make -C testdata/inventory`.' \
		'Do not hand-edit binaries; change sources and rebuild.' \
		'' \
		'## sample_macho_fat' \
		'' \
		'Single-arch universal Mach-O (`cafebabe` header + x86_64 thin slice).' \
		'Regenerated by `scripts/wrap-macho-fat.py` from `sample_macho` — not a' \
		'hand-copied Apple SDK binary. Provenance: LADING gocross fixture +' \
		'deterministic fat wrapper (see Makefile rule).' \
		> $@

clean:
	rm -rf $(BIN)

verify: all
	@command -v file >/dev/null && file $(BIN)/*_elf $(BIN)/sample_* || true
	@command -v readelf >/dev/null && \
		echo '--- dyn_stripped ---' && readelf -h $(BIN)/dyn_stripped_elf | head -5 && \
		echo '--- static_stripped ---' && readelf -h $(BIN)/static_stripped_elf | head -5 && \
		(readelf -d $(BIN)/static_stripped_elf 2>&1 | grep -E 'NEEDED|INTERP' || echo 'static: no NEEDED/INTERP') && \
		(readelf -S $(BIN)/dyn_stripped_elf | grep symtab || echo 'stripped: no .symtab') && \
		(readelf -S $(BIN)/dyn_unstripped_elf | grep symtab || true)

# Regenerate committed hash manifest (run after rebuilding fixtures).
# Paths are repo-relative so sha checks work on every OS checkout.
fixtures.sha: $(FIXTURES)
	@cd $(REPO) && \
		( for f in $(patsubst $(REPO)/%,%,$(FIXTURES)); do \
			if command -v sha256sum >/dev/null 2>&1; then sha256sum "$$f"; \
			else shasum -a 256 "$$f"; fi; \
		done ) | sort -k2 > testdata/inventory/FIXTURES.sha
	@echo "wrote testdata/inventory/FIXTURES.sha"

# CI / local: every FIXTURES entry tracked + hash-matches FIXTURES.sha.
verify-fixtures:
	@bash $(REPO)/.github/scripts/check-fixtures.sh --hash
