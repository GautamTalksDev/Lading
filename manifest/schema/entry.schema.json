{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gautamtalksdev/lading/manifest/schema/entry.schema.json",
  "title": "Lading Manifest component file",
  "description": "One YAML/JSON document describing a single software component and its CVE entries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["component", "entries"],
  "properties": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ecosystem", "purls", "identity_symbols"],
      "properties": {
        "provenance_status": {
          "type": "string",
          "enum": ["verified", "unverified"],
          "default": "unverified",
          "description": "Whether upstream_fix_commit URLs have been machine-verified (HTTP 200). Components marked unverified cannot produce D01/D02 verdicts."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Short component name; file is manifest/components/<ecosystem>/<name>.yaml."
        },
        "ecosystem": {
          "type": "string",
          "minLength": 1,
          "description": "Ecosystem bucket (e.g. native, openssl)."
        },
        "purls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Canonical PURLs this entry covers."
        },
        "identity_symbols": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Normalized symbols whose presence indicates this component."
        },
        "identity_strings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Rodata regexes indicating this component and optionally version."
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cve", "affected_versions", "vulnerable_symbols", "manifest_version"],
      "properties": {
        "cve": {
          "type": "string",
          "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
        },
        "affected_versions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Exact version strings only in v1 — no ranges."
        },
        "vulnerable_symbols": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/vulnerable_symbol" }
        },
        "notes": { "type": "string" },
        "manifest_version": {
          "type": "string",
          "minLength": 1,
          "description": "Semver of the Manifest at time of entry."
        }
      }
    },
    "vulnerable_symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "confidence", "provenance"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Normalized symbol name."
        },
        "confidence": {
          "type": "string",
          "enum": ["definitive", "probable"],
          "description": "probable entries must never drive not_affected."
        },
        "dynsym_export_verified": {
          "type": "boolean",
          "default": false,
          "description": "Asserts the symbol was verified present in .dynsym on a reference build. D02 refuses with reason_code symbol_not_observable when this field is absent or false. See FINDING-002."
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_fix_commit", "derivation", "reviewed_by", "reviewed_at"],
      "properties": {
        "upstream_fix_commit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://",
          "description": "URL of the upstream fix commit. REQUIRED — missing URL fails validation."
        },
        "derivation": {
          "type": "string",
          "enum": ["patch-touched-function", "advisory-named", "manual"]
        },
        "reviewed_by": { "type": "string", "minLength": 1 },
        "reviewed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "ISO date YYYY-MM-DD."
        }
      }
    }
  }
}
