# Local operator caches (git clones for manifest derive)
.lading/

# Corpus artifact binaries (regenerate: scripts/corpus-download.sh)
corpus/downloads/

# Python venv (CP-8 schema validation)
.venv/
__pycache__/
*.pyc

# Scan/verify output directories
lading-out/
/out/

# Signing material — belongs outside the repo (CP-3 DoD)
cosign.key
cosign.pub
*.crt
ed25519*

# Local corpus scratch
corpus/downloads/
corpus/tmp/

# Test fixtures are intentionally committed (see testdata/inventory/Makefile).
# *.exe above would otherwise drop sample_pe.exe on Windows checkouts — the
# directory un-ignore alone does not override the extension rule.
!testdata/inventory/bin/
!testdata/inventory/bin/**
!testdata/inventory/bin/*.exe
